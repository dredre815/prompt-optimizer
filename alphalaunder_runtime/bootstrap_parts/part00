set -Eeuo pipefail
umask 077

ISSUE_NUMBER="${ALPHALAUNDER_ISSUE_NUMBER:-12}"
RESULT_BRANCH="${ALPHALAUNDER_RESULT_BRANCH:-alphalaunder-deepseek-v4-results-20260803}"
WORKERS="${ALPHALAUNDER_WORKERS:-4}"
