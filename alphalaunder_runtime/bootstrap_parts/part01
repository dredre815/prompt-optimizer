redact_and_scan_outputs() {
  local key="${DEEPSEEK_API_KEY:-}"
  python - "$RESULTS" "$key" <<'PY'
from pathlib import Path
import re, sys
root = Path(sys.argv[1])
secret = sys.argv[2].encode()
pattern = re.compile(rb"sk-[A-Za-z0-9_\-]{20,}")
for p in root.rglob("*"):
    if not p.is_file():
        continue
    raw = p.read_bytes()
    new = raw.replace(secret, b"[REDACTED_DEEPSEEK_KEY]") if secret else raw
    new = pattern.sub(b"[REDACTED_API_KEY_PATTERN]", new)
    if new != raw:
        p.write_bytes(new)
# Exact-secret absence is a publication invariant.
if secret:
    hits = [str(p) for p in root.rglob("*") if p.is_file() and secret in p.read_bytes()]
    if hits:
        raise SystemExit("credential-remnant files: " + ",".join(hits))
PY
  unset DEEPSEEK_API_KEY
}

write_bootstrap_status() {
  local rc="$1"
  python - "$STATUS" "$RESULTS/runtime_status.json" "$RESULTS/model_probe.json" "$rc" "$NONCE" <<'PY'
import json, sys
from pathlib import Path
out_path, runtime_path, probe_path, rc, nonce = sys.argv[1:]
out = {"bootstrap_exit_code": int(rc), "nonce": nonce, "runner_completed": int(rc) == 0}
for key, path in (("runtime_status", runtime_path), ("model_probe", probe_path)):
    p = Path(path)
    if p.exists():
        try:
            out[key] = json.loads(p.read_text(encoding="utf-8"))
        except Exception as exc:
            out[key + "_read_error"] = str(exc)
Path(out_path).write_text(json.dumps(out, indent=2), encoding="utf-8")
PY
}

